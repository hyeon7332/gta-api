<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.gta.mapper.CommonCodeMapper">

    <!-- 공통 코드 목록 조회 -->
    <select id="selectCommonCodes" parameterType="string" resultType="com.gta.dto.CommonCodeDto">
        SELECT
            code_id,
            group_code,
            code_value,
            code_name,
            sort_order,
            use_yn
        FROM common_code
        WHERE group_code = #{groupCode}
          AND use_yn = 'Y'
        ORDER BY sort_order ASC
    </select>
</mapper>    
