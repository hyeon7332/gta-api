<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.gta.mapper.AuthMapper">

	<!-- 로그인 -->
	<select id="findByLoginId" parameterType="string" resultType="com.gta.entity.User">
	    SELECT
	        user_id,
	        login_id,
	        password,
	        nickname,
	        role,
	        use_yn,
	        created_at,
	        updated_at
	    FROM user
	    WHERE login_id = #{loginId}
	</select>
	
</mapper>